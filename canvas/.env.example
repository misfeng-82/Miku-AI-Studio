# 复制成 .env 后填写。.env 已在 .gitignore 里，不会进仓库。

# ===== AutoDL Art · ComfyUI 工作流 =====
# 令牌获取：https://autodl.art/large-model/tokens → 创建令牌 → 分组必须选 ComfyUI
# 普通 LLM 分组的令牌调 ComfyUI 接口会 403 permission_denied
AUTODL_TOKEN=
AUTODL_BASE_URL=https://autodl.art

# 工作流 ID：点开工作流后，右侧抽屉里能看到
# 文生视频（无参考图）
WORKFLOW_TEXT2VIDEO=minimax_h3_lightx2v_no_pic
# 图生视频（多图 + 多音频）
WORKFLOW_REFVIDEO=minimax_h3_image_audio_to_video_v2_15s
# 图片生成工作流（可选，留空则图片节点也走 REFVIDEO）
WORKFLOW_IMAGE=

# 默认参数（按秒计费：480p≈0.04 元/秒，15 秒一镜≈0.6 元）
DEFAULT_RESOLUTION=480p竖
DEFAULT_DURATION=15

# 轮询间隔与总超时
POLL_MS=4000
TIMEOUT_MS=900000

# 1 = 强制模拟（不调模型、不花钱），0 = 真实调用
FORCE_MOCK=1
