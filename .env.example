# 复制为 .env 后填写。本文件只放占位值，真实密钥绝不入库。

# 服务
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# 访问口令：留空 = 不启用门禁（本机使用）。
# 公网部署必须设置，否则任何拿到链接的人都能改设置、删作品。
# 生成一个随机口令：
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ACCESS_TOKEN=

# 限流（按 IP 计，窗口 60 秒）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# LLM：默认 1（离线样本），不产生任何费用
USE_MOCK=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# 爆款榜单抓取：默认 1（离线样本库）
CRAWL_USE_MOCK=1
CRAWL_ENDPOINT=
CRAWL_TIMEOUT_MS=15000

# 任务重试
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_MS=500
