# 复制为 .env 后填写。本文件只放占位值，真实密钥绝不入库。

# 服务
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# LLM：默认 1（离线样本），不产生任何费用
USE_MOCK=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# 爆款榜单抓取：默认 1（离线样本库）
CRAWL_USE_MOCK=1
CRAWL_ENDPOINT=
CRAWL_TIMEOUT_MS=15000

# 任务重试
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_MS=500
