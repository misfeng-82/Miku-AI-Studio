# 本文件只放占位值，真实密钥绝不入库。
#
# ⚠️ 重要：本项目**不会自动读取 .env**（零依赖，没装 dotenv）。
# 复制成 .env 后必须显式告诉 Node 去读，否则一行都不会生效：
#
#   本地开发：  node --env-file=.env src/server.js
#   或者      ： export $(grep -v '^#' .env | xargs) && node src/server.js
#   systemd   ： 用 EnvironmentFile=/etc/miku/miku.env（systemd 原生读取）
#
# 服务器部署请直接用 deploy/oracle/ 里的脚本，它会生成 /etc/miku/miku.env。

# 服务
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# 访问口令：留空 = 不启用门禁（本机使用）。
# 公网部署必须设置，否则任何拿到链接的人都能改设置、删作品。
# 生成一个随机口令：
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ACCESS_TOKEN=

# 限流（按 IP 计，窗口 60 秒）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# LLM：默认 1（离线样本），不产生任何费用
USE_MOCK=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# 爆款榜单来源：默认 0 = 直接抓红果官网当天榜单（真实数据，不花钱）
#   抓取目标 https://hongguoduanju.com/rank/hot-real-drama（公开页面）
#   抓不到时自动回落内置剧目库 assets/hotDramas.js，并在接口里带 fallbackReason
# 想完全不联网（离线开发 / 跑自动化测试）再设成 1
# CRAWL_ENDPOINT 留空表示走内置抓取器；填了则优先用你自己的榜单接口（需返回 items 数组）
CRAWL_USE_MOCK=0
CRAWL_ENDPOINT=
CRAWL_TIMEOUT_MS=15000
# 自动抓取周期（cron，服务运行时生效）。默认每周一 09:00 爬一次。
#   注意：cron 值本身含空格，只能用 node --env-file=.env 加载；
#   用 export $(grep -v '^#' .env | xargs) 会被拆坏，那种方式请给值加引号。
#   每天 00:30 一次：  CRAWL_CRON=30 0 * * *
#   每周一 09:00（默认）：CRAWL_CRON=0 9 * * 1
#   每 6 小时一次：    CRAWL_CRON=0 */6 * * *
CRAWL_CRON=0 9 * * 1

# 任务重试
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_MS=500
