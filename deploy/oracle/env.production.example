# /etc/miku/miku.env —— 由 setup.sh 生成，权限 600，属主 root
# systemd 通过 EnvironmentFile= 读取（本项目不自动加载 .env）

# ── 运行环境 ─────────────────────────────────────────────
NODE_ENV=production
# 只监听本机：外网由 Caddy 反代，应用端口不直接暴露
HOST=127.0.0.1
PORT=8787

# 数据目录放在 /var/lib 下（独立于代码目录），
# 这样 git pull 更新代码时不会覆盖作品数据
DATA_DIR=/var/lib/miku/data

# ── 访问口令（必填，公网裸奔的唯一边界）─────────────────
# setup.sh 会随机生成；改这里后 systemctl restart miku 立刻生效
ACCESS_TOKEN=

# ── 同源部署下 CORS 可以不填；跨域调用才需要写满 ─────────
CORS_ORIGINS=

# ── 模型：默认离线样本引擎，零费用 ──────────────────────
USE_MOCK=1
# 要接真模型时改成 0，并填下面三项（Key 存在服务器上，所有访客共用你的额度）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── 抓取：默认内置榜单，不发外部请求 ────────────────────
CRAWL_USE_MOCK=1

# ── 限流（每 IP，窗口 60 秒）────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# ── 隐私：确保 LangSmith 追踪不会把提示词发出去 ─────────
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
